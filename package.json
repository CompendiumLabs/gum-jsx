{
  "name": "gum-jsx",
  "version": "1.7.1",
  "description": "Language for vector graphics generation.",
  "type": "module",
  "author": "Douglas Hanley",
  "homepage": "https://github.com/CompendiumLabs/gum-jsx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx.git"
  },
  "license": "MIT",
  "files": [
    "src",
    "scripts",
    "test/unit.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./eval": "./src/eval.ts",
    "./math": "./src/math.ts",
    "./render": "./src/render.ts",
    "./mark": "./src/mark.ts",
    "./meta": "./src/meta.ts",
    "./test": "./test/unit.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "gum": "bun ./scripts/gum.ts",
    "tex": "bun ./scripts/tex.ts",
    "mark": "bun ./scripts/mark.ts",
    "test": "bun ./test/run.ts",
    "compare": "bun ./scripts/compare.ts",
    "report": "cd test/report && bun install && bun run dev",
    "typecheck": "bun tsc --noEmit"
  },
  "bin": {
    "gum": "scripts/gum.ts",
    "gum-tex": "scripts/tex.ts",
    "gum-mark": "scripts/mark.ts"
  },
  "dependencies": {
    "@gum-jsx/core": "^1.7.1",
    "@gum-jsx/docs": "^1.7.0",
    "@gum-jsx/mark": "^1.7.0",
    "@gum-jsx/math": "^1.7.1",
    "@gum-jsx/node": "^1.7.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "canvas": "^3.2.3",
    "katex": "^0.16.33",
    "typescript": "^5.9.3"
  }
}
