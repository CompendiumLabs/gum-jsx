{
  "name": "gum-jsx",
  "private": true,
  "workspaces": [
    "gum-jsx-core",
    "gum-jsx-math",
    "gum-jsx-png",
    "gum-jsx-pdf",
    "gum-jsx-react",
    "gum-jsx-mark",
    "gum-jsx-cli",
    "gum-jsx-edit",
    "gum-jsx-docs",
    "gum-jsx-mcp"
  ],
  "scripts": {
    "gum": "bun gum-jsx-cli/src/cli.ts",
    "gum-tex": "bun gum-jsx-cli/src/tex.ts",
    "gum-mark": "bun gum-jsx-cli/src/mark.ts",
    "skill": "bun --filter @gum-jsx/docs skill",
    "dev": "bun --filter @gum-jsx/edit dev",
    "build": "bun --filter @gum-jsx/edit build",
    "compare": "bun gum-jsx-math/scripts/compare.ts",
    "visual-test": "bun --filter @gum-jsx/cli visual-test",
    "visual-report": "bun --filter @gum-jsx/cli visual-report",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun --filter @gum-jsx/core test && bun --filter @gum-jsx/math test && bun --filter @gum-jsx/pdf test && bun --filter @gum-jsx/react test && bun --filter @gum-jsx/mark test && bun --filter @gum-jsx/cli test && bun --filter @gum-jsx/docs check && bun --filter @gum-jsx/edit check"
  },
  "patchedDependencies": {
    "fast-png@8.0.0": "gum-jsx-pdf/patches/fast-png@8.0.0.patch"
  }
}
