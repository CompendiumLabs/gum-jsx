{
  "name": "gum-jsx",
  "version": "1.9.0",
  "description": "Language for vector graphics generation.",
  "type": "module",
  "author": "Douglas Hanley",
  "homepage": "https://github.com/CompendiumLabs/gum-jsx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx.git"
  },
  "license": "MIT",
  "files": [
    "src",
    "scripts",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.ts"
    },
    "./eval": {
      "types": "./types/eval.d.ts",
      "import": "./src/eval.ts"
    },
    "./math": {
      "types": "./types/math.d.ts",
      "import": "./src/math.ts"
    },
    "./render": {
      "types": "./types/render.d.ts",
      "import": "./src/render.ts"
    },
    "./mark": {
      "types": "./types/mark.d.ts",
      "import": "./src/mark.ts"
    },
    "./meta": {
      "types": "./types/meta.d.ts",
      "import": "./src/meta.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "gum": "bun ./scripts/gum.ts",
    "tex": "bun ./scripts/tex.ts",
    "mark": "bun ./scripts/mark.ts",
    "test": "bun ./test/run.ts",
    "compare": "bun ./scripts/compare.ts",
    "report": "cd test/report && bun install && bun run dev",
    "typecheck": "bun tsc --noEmit",
    "types": "rm -rf types && bun tsc -p tsconfig.types.json",
    "prepublishOnly": "bun run types"
  },
  "bin": {
    "gum": "scripts/gum.ts",
    "gum-tex": "scripts/tex.ts",
    "gum-mark": "scripts/mark.ts"
  },
  "dependencies": {
    "@gum-jsx/core": "^1.9.0",
    "@gum-jsx/docs": "^1.9.0",
    "@gum-jsx/mark": "^1.9.0",
    "@gum-jsx/math": "^1.9.0",
    "@gum-jsx/node": "^1.9.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "canvas": "^3.2.3",
    "katex": "^0.16.33",
    "typescript": "^5.9.3"
  }
}
