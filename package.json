{
  "name": "gum-jsx",
  "version": "2.1.0-beta.0",
  "description": "Render JSX plots, diagrams, math, slides, and animations with the gum command.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gum": "dist/npm/cli.js"
  },
  "scripts": {
    "gum": "bun src/cli.ts",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "standalone:build": "bun scripts/standalone.ts",
    "standalone:pack": "bun scripts/standalone.ts --archive",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@gum-jsx/cli": "2.1.0-beta.0",
    "@gum-jsx/core": "2.1.0-beta.0",
    "@gum-jsx/docs": "2.1.0-beta.0",
    "@gum-jsx/math": "2.1.0-beta.0",
    "@gum-jsx/mp4": "2.1.0-beta.0",
    "@gum-jsx/maps": "2.1.0-beta.0",
    "@gum-jsx/pdf": "2.1.0-beta.0",
    "@gum-jsx/pptx": "2.1.0-beta.0",
    "@gum-jsx/png": "2.1.0-beta.0",
    "@types/bun": "latest",
    "commander": "^14.0.3",
    "fast-png": "^8.0.0",
    "typescript": "^7"
  },
  "homepage": "https://compendiumlabs.ai/gum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx.git"
  },
  "bugs": {
    "url": "https://github.com/CompendiumLabs/gum-jsx/issues"
  },
  "keywords": [
    "graphics",
    "diagrams",
    "math",
    "maps",
    "plotting",
    "networks",
    "slides",
    "animations"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.2"
  },
  "files": [
    "dist/npm",
    "README.md",
    "LICENSE",
    "images"
  ]
}
