{
  "name": "gum-jsx",
  "private": true,
  "workspaces": [
    "gum-jsx-core",
    "gum-jsx-math",
    "gum-jsx-png",
    "gum-jsx-pdf",
    "gum-jsx-react",
    "gum-jsx-mark",
    "gum-jsx-cli",
    "gum-jsx-edit",
    "gum-jsx-docs",
    "gum-jsx-mcp",
    "gum-jsx-maps"
  ],
  "scripts": {
    "gum": "bun gum-jsx-cli/src/cli.ts",
    "gum-tex": "bun gum-jsx-cli/src/tex.ts",
    "gum-mark": "bun gum-jsx-cli/src/mark.ts",
    "dev": "bun --filter @gum-jsx/edit dev",
    "build": "bun --filter @gum-jsx/edit build",
    "plugin:build": "bun gum-jsx-docs/scripts/plugin-build.ts",
    "plugin:pack": "bun gum-jsx-docs/scripts/plugin-pack.ts",
    "compare": "bun gum-jsx-math/scripts/compare.ts",
    "visual-test": "bun --filter @gum-jsx/cli visual-test",
    "visual-report": "bun --filter @gum-jsx/cli visual-report",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun run --workspaces test",
    "perf": "bun test/perf.ts",
    "perf:core": "bun gum-jsx-core/test/perf/run.ts",
    "perf:math": "bun gum-jsx-math/test/perf/run.ts",
    "perf:maps": "bun gum-jsx-maps/test/perf/run.ts",
    "perf:demos": "bun gum-jsx-docs/test/perf/run.ts",
    "perf:freeze": "bun test/perf-freeze.ts",
    "rehearse": "bash scripts/rehearse.sh"
  }
}
