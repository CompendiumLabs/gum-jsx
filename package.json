{
  "name": "gum-jsx",
  "private": true,
  "workspaces": [
    "gum-jsx-core",
    "gum-jsx-math",
    "gum-jsx-png",
    "gum-jsx-pdf",
    "gum-jsx-react",
    "gum-jsx-mark",
    "gum-jsx-cli",
    "gum-jsx-edit",
    "gum-jsx-docs",
    "gum-jsx-mcp"
  ],
  "scripts": {
    "gum": "bun gum-jsx-cli/src/cli.ts",
    "gum-tex": "bun gum-jsx-cli/src/tex.ts",
    "gum-mark": "bun gum-jsx-cli/src/mark.ts",
    "skill": "bun --filter @gum-jsx/docs skill",
    "dev": "bun --filter @gum-jsx/edit dev",
    "build": "bun --filter @gum-jsx/edit build",
    "compare": "bun gum-jsx-math/scripts/compare.ts",
    "visual-test": "bun --filter @gum-jsx/cli visual-test",
    "visual-report": "bun --filter @gum-jsx/cli visual-report",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun run test:imports && bun run --workspaces --sequential test",
    "test:imports": "bun test/imports.ts",
    "release:pack": "bun scripts/release.ts",
    "release:check": "bun test/release.ts",
    "props:generate": "node gum-jsx-core/scripts/prop-schemas.mjs && node gum-jsx-core/scripts/prop-schemas.mjs --package=gum-jsx-math",
    "props:check": "node gum-jsx-core/scripts/prop-schemas.mjs --check && node gum-jsx-core/scripts/prop-schemas.mjs --package=gum-jsx-math --check"
  }
}
